{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.invalid/schemas/workorder.schema.json",
  "title": "keel work order",
  "description": "A work order, .keel/proposals/<P>-<slug>/workorders/T<n>.yaml, written by the planner (on the patch track derived by the Steward from the anchors). The engineer never reads it directly: keel compiles it into the task's brief. It carries the ACC to acceptance command and matrix-row table, the frozen tests (always outside write_set), interfaces, global constraints copied verbatim, at most five review focus items and derived_from hashes.",
  "x-keel-status": "stable",
  "x-keel-milestone": "M2",
  "type": "object",
  "properties": {
    "id": {
      "description": "<P>.T<n>; the T<n> part equals the file name stem.",
      "$ref": "common.schema.json#/$defs/taskId"
    },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "$ref": "#/$defs/taskKind" },
    "objective": { "type": "string", "minLength": 1 },
    "charter_version": { "$ref": "common.schema.json#/$defs/semver" },
    "covers": {
      "type": "object",
      "properties": {
        "acc": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/accId" },
          "minItems": 1,
          "uniqueItems": true
        },
        "requirements": {
          "type": "array",
          "items": {
            "anyOf": [
              { "$ref": "common.schema.json#/$defs/reqId" },
              { "$ref": "common.schema.json#/$defs/scenarioRef" }
            ]
          },
          "uniqueItems": true
        }
      },
      "required": ["acc", "requirements"],
      "additionalProperties": false
    },
    "after": {
      "description": "Tasks that must be verified before this one starts.",
      "type": "array",
      "items": {
        "anyOf": [
          { "$ref": "common.schema.json#/$defs/taskLocalId" },
          { "$ref": "common.schema.json#/$defs/taskId" }
        ]
      },
      "uniqueItems": true
    },
    "write_set": { "$ref": "#/$defs/writeSet" },
    "frozen_tests": {
      "description": "Test paths the builder may not touch; outside write_set by construction.",
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/repoGlob" },
      "uniqueItems": true
    },
    "interfaces": {
      "type": "object",
      "properties": {
        "consumes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "contract": {
                "description": "Signature or shape of the interface.",
                "type": "string",
                "minLength": 1
              },
              "from": {
                "description": "The producing task.",
                "anyOf": [
                  { "$ref": "common.schema.json#/$defs/taskLocalId" },
                  { "$ref": "common.schema.json#/$defs/taskId" }
                ]
              }
            },
            "required": ["name", "from"],
            "additionalProperties": false
          }
        },
        "produces": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "contract": {
                "description": "Signature or shape of the interface.",
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["name"],
            "additionalProperties": false
          }
        }
      },
      "required": ["consumes", "produces"],
      "additionalProperties": false
    },
    "acceptance": {
      "description": "The ACC to acceptance command and matrix-row table, fixed before the build.",
      "type": "array",
      "items": { "$ref": "#/$defs/acceptanceRow" },
      "minItems": 1
    },
    "global_constraints": {
      "description": "Copied verbatim from the frozen intent (Always, Never, scope) and the in-scope INV and ADR obligations.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "review_focus": {
      "description": "What the lenses should look at first. The count limit is the tunable caps.review_focus_max (config, default 5), enforced by the plan gate check plan.review-focus rather than by this schema.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "stop_classes": {
      "description": "Task-specific examples of the four stop classes, which always apply and always go to the Board.",
      "type": "array",
      "items": { "$ref": "#/$defs/stopClassNote" }
    },
    "route_hint": {
      "type": "object",
      "properties": {
        "seat": { "$ref": "common.schema.json#/$defs/seat" },
        "tier": { "$ref": "common.schema.json#/$defs/tier" }
      },
      "required": ["seat", "tier"],
      "additionalProperties": false
    },
    "budget": { "$ref": "goals.schema.json#/$defs/budget" },
    "derived_from": { "$ref": "plan.schema.json#/$defs/derivedFrom" },
    "notes": {
      "description": "Task notes (below the plan in the precedence order).",
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "title",
    "kind",
    "objective",
    "charter_version",
    "covers",
    "after",
    "write_set",
    "frozen_tests",
    "interfaces",
    "acceptance",
    "global_constraints",
    "review_focus",
    "stop_classes",
    "route_hint",
    "budget",
    "derived_from"
  ],
  "additionalProperties": false,
  "$defs": {
    "taskKind": {
      "description": "build: implement against the frozen tests; test: write acceptance tests first, routed to a declared family different from the builder's, landing first; resolution: resolve an integration conflict.",
      "enum": ["build", "test", "resolution"]
    },
    "writeSet": {
      "description": "Paths and symbols a task may write. The submit gate requires the diff to be a subset.",
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/repoGlob" },
          "minItems": 1
        },
        "symbols": {
          "description": "Optional symbol-level scope, for example src/store/tags.ts#addTag.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["paths", "symbols"],
      "additionalProperties": false
    },
    "acceptanceRow": {
      "description": "One row of the ACC to command table; it becomes a first-class section of receipt.md.",
      "type": "object",
      "properties": {
        "acc": { "$ref": "common.schema.json#/$defs/accId" },
        "evidence_mode": { "$ref": "common.schema.json#/$defs/evidenceMode" },
        "commands": {
          "description": "Acceptance commands, run without a shell; empty only for review, manual and unobservable modes.",
          "type": "array",
          "items": { "$ref": "evidence.schema.json#/$defs/command" }
        },
        "rows": {
          "description": "Matrix rows: the scenarios whose tagged JUnit rows ([R-<area>-<5>#S<n>] in the test name) must pass.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/scenarioRef" }
        }
      },
      "required": ["acc", "evidence_mode", "commands", "rows"],
      "additionalProperties": false
    },
    "stopClassNote": {
      "type": "object",
      "properties": {
        "class": { "$ref": "common.schema.json#/$defs/stopClass" },
        "examples": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["class", "examples"],
      "additionalProperties": false
    }
  }
}
