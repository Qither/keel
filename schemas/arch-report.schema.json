{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.invalid/schemas/arch-report.schema.json",
  "title": "keel architecture report (deferred stub)",
  "description": "Deferred to M4: impact, drift and search reports, index status and series points. Only the minimal shape below is checked; other fields are allowed until M4 fixes the shape. Reports stamp index freshness, and every edge carries provenance.",
  "x-keel-status": "stub",
  "x-keel-milestone": "M4",
  "type": "object",
  "properties": {
    "kind": {
      "enum": ["impact", "drift", "search", "index-status", "series-point"]
    },
    "commit": { "$ref": "common.schema.json#/$defs/gitOid" },
    "freshness": { "$ref": "common.schema.json#/$defs/freshness" }
  },
  "required": ["kind", "commit"],
  "$defs": {
    "seriesPoint": {
      "description": "Deferred to M4: one line of .keel/arch/series.jsonl, appended by the archive commit. Only the listed fields are checked.",
      "x-keel-status": "stub",
      "x-keel-milestone": "M4",
      "type": "object",
      "properties": {
        "commit": { "$ref": "common.schema.json#/$defs/gitOid" },
        "violations_new": { "type": "integer", "minimum": 0 },
        "known": { "type": "integer", "minimum": 0 },
        "cross_element_edges": { "type": "integer", "minimum": 0 },
        "unmapped": { "type": "integer", "minimum": 0 },
        "churn_by_element": { "type": "object" },
        "by_seat": { "type": "object" },
        "by_runtime": { "type": "object" }
      },
      "required": ["commit", "violations_new", "known", "cross_element_edges", "unmapped"]
    }
  }
}
