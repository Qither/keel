{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.invalid/schemas/arch-model.schema.json",
  "title": "keel architecture model",
  "description": "The declared architecture, .keel/arch/model.yaml (L4). It changes only through an arch.delta applied by the land archive commit. The derived graph from the index behind the IndexProvider port joins it by element ids; unmapped files are listed and never guessed.",
  "x-keel-status": "stable",
  "x-keel-milestone": "M4",
  "type": "object",
  "properties": {
    "elements": {
      "type": "array",
      "items": { "$ref": "#/$defs/element" },
      "minItems": 1
    },
    "layers": {
      "description": "Layer names from top to bottom; a layer:<name> tag places an element.",
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/slug" },
      "uniqueItems": true
    },
    "mapping": {
      "type": "object",
      "properties": {
        "overrides": {
          "description": "Explicit path to element assignments that win over glob specificity.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "$ref": "common.schema.json#/$defs/repoGlob" },
              "element": { "$ref": "common.schema.json#/$defs/elementId" }
            },
            "required": ["path", "element"],
            "additionalProperties": false
          }
        },
        "ignore": {
          "description": "Paths that are never mapped.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/repoGlob" }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["elements"],
  "additionalProperties": false,
  "$defs": {
    "element": {
      "description": "A C4 element.",
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/elementId" },
        "kind": {
          "enum": ["system", "container", "component"]
        },
        "parent": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/elementId" }, { "type": "null" }]
        },
        "title": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "paths": {
          "description": "Path globs; each file maps to the most specific glob.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/repoGlob" }
        },
        "owner": { "description": "Owner label; routes reviewers from M4.", "type": "string", "minLength": 1 },
        "tags": {
          "description": "Tags such as layer:web, stakes:high or public-api.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/relation" }
        },
        "adrs": {
          "description": "Derived projection of the governs lists of accepted decisions (.keel/decisions/*.md), refreshed by the land archive commit and by the governance commit that accepts a decision; never edited by hand or by an arch delta. governs is the single source.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/adrId" },
          "uniqueItems": true
        }
      },
      "required": ["id", "kind", "parent", "title", "paths", "owner"],
      "additionalProperties": false
    },
    "relation": {
      "description": "A declared relation.",
      "type": "object",
      "properties": {
        "to": { "$ref": "common.schema.json#/$defs/elementId" },
        "kind": {
          "description": "Relation kind, for example uses or reads.",
          "$ref": "common.schema.json#/$defs/slug"
        },
        "note": { "type": "string", "minLength": 1 }
      },
      "required": ["to", "kind"],
      "additionalProperties": false
    }
  }
}
