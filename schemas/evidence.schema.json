{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.invalid/schemas/evidence.schema.json",
  "title": "keel runner evidence",
  "description": "Runner evidence, EV-<sha12>.json (L10): commands, exit codes, output digests, JUnit rows mapped to scenarios and ACC, the not_run list and the red/green proof. Only the Steward runner's evidence counts, taken in a clean sparse detached checkout. It is reused only when every match field of the source-state binding is equal; land always re-executes the full acceptance matrix in-process, so EV files are a cache. NOT_RUN is never PASS.",
  "x-keel-status": "stable",
  "x-keel-milestone": "M3",
  "type": "object",
  "properties": {
    "subject": {
      "anyOf": [
        { "$ref": "common.schema.json#/$defs/proposalId" },
        { "$ref": "common.schema.json#/$defs/taskId" }
      ]
    },
    "binding": { "$ref": "common.schema.json#/$defs/sourceStateBinding" },
    "taken_at": { "$ref": "common.schema.json#/$defs/isoDateTime" },
    "checkout": {
      "description": "A clean sparse detached checkout of the recorded commit.",
      "const": "detached-sparse"
    },
    "runner": {
      "type": "object",
      "properties": {
        "keel_version": { "$ref": "common.schema.json#/$defs/semver" },
        "os": {
          "enum": ["win32", "linux", "darwin"]
        },
        "node": { "description": "Node version.", "type": "string", "minLength": 1 }
      },
      "required": ["keel_version", "os", "node"],
      "additionalProperties": false
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/commandRun" }
    },
    "rows": {
      "description": "Parsed JUnit rows. Skipped or filtered rows count as missing.",
      "type": "array",
      "items": { "$ref": "#/$defs/junitRow" }
    },
    "acceptance": {
      "description": "Per-ACC results with denominators.",
      "type": "array",
      "items": { "$ref": "#/$defs/accResult" }
    },
    "not_run": {
      "description": "What was not run, explicitly.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["item", "reason"],
        "additionalProperties": false
      }
    },
    "red_green": {
      "anyOf": [{ "$ref": "#/$defs/redGreen" }, { "type": "null" }]
    }
  },
  "required": [
    "subject",
    "binding",
    "taken_at",
    "checkout",
    "runner",
    "commands",
    "rows",
    "acceptance",
    "not_run",
    "red_green"
  ],
  "additionalProperties": false,
  "$defs": {
    "command": {
      "description": "A command the runner executes with shell:false. It never carries environment values.",
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "cwd": {
          "description": "Working directory relative to the checkout root (default: the root).",
          "$ref": "common.schema.json#/$defs/repoPath"
        },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "junit": {
          "description": "JUnit XML report the command writes; rows tagged [R-<area>-<5>#S<n>] map to scenarios.",
          "$ref": "common.schema.json#/$defs/repoPath"
        }
      },
      "required": ["argv"],
      "additionalProperties": false
    },
    "commandRun": {
      "type": "object",
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "exit_code": { "type": "integer" },
        "status": { "$ref": "common.schema.json#/$defs/checkStatus" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "stdout_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "stderr_sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      },
      "required": ["command", "exit_code", "status", "duration_ms", "stdout_sha256", "stderr_sha256"],
      "additionalProperties": false
    },
    "junitRow": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "scenarios": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/scenarioRef" }
        },
        "status": {
          "enum": ["passed", "failed", "skipped", "error"]
        }
      },
      "required": ["name", "scenarios", "status"],
      "additionalProperties": false
    },
    "accResult": {
      "type": "object",
      "properties": {
        "acc": { "$ref": "common.schema.json#/$defs/accId" },
        "evidence_mode": { "$ref": "common.schema.json#/$defs/evidenceMode" },
        "status": { "$ref": "common.schema.json#/$defs/checkStatus" },
        "passed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      },
      "required": ["acc", "evidence_mode", "status", "passed", "total"],
      "additionalProperties": false
    },
    "redGreen": {
      "description": "Red-before/green-after proof for policy lands: at least one cited item fails at base and passes at the change; otherwise the change needs a per-change contract approval.",
      "type": "object",
      "properties": {
        "base": { "$ref": "common.schema.json#/$defs/gitOid" },
        "change": { "$ref": "common.schema.json#/$defs/gitOid" },
        "cited": {
          "description": "Cited scenarios, or tests fixed first by a different-family test task.",
          "type": "array",
          "items": {
            "anyOf": [
              { "$ref": "common.schema.json#/$defs/scenarioRef" },
              { "$ref": "common.schema.json#/$defs/repoPath" }
            ]
          },
          "minItems": 1
        },
        "red_at_base": { "type": "boolean" },
        "green_at_change": { "type": "boolean" },
        "status": { "$ref": "common.schema.json#/$defs/checkStatus" }
      },
      "required": ["base", "change", "cited", "red_at_base", "green_at_change", "status"],
      "additionalProperties": false
    }
  }
}
