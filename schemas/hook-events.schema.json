{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.invalid/schemas/hook-events.schema.json",
  "title": "keel hook events",
  "description": "The canonical hook-event table, runtimes/hook-events.yaml: canonical events mapped to each runtime's native events, with blockability and verification status. keel hook <canonical event> --runtime <id> is the single entry point; TS literal types and snippets are generated from this table.",
  "x-keel-status": "stable",
  "x-keel-milestone": "M2",
  "type": "object",
  "properties": {
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" },
      "minItems": 1
    }
  },
  "required": ["events"],
  "additionalProperties": false,
  "$defs": {
    "event": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Canonical event id, for example pre-tool-use or post-compact.",
          "$ref": "common.schema.json#/$defs/slug"
        },
        "description": { "type": "string", "minLength": 1 },
        "native": {
          "type": "array",
          "items": { "$ref": "#/$defs/nativeEvent" }
        }
      },
      "required": ["id", "description", "native"],
      "additionalProperties": false
    },
    "nativeEvent": {
      "type": "object",
      "properties": {
        "runtime": { "$ref": "common.schema.json#/$defs/runtimeId" },
        "name": { "description": "Native event name.", "type": "string", "minLength": 1 },
        "matcher": {
          "description": "Matcher that narrows the native event, for example compact on SessionStart.",
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "blockable": { "type": "boolean" },
        "verification_status": { "$ref": "common.schema.json#/$defs/verificationStatus" },
        "note": { "type": "string", "minLength": 1 }
      },
      "required": ["runtime", "name", "blockable", "verification_status"],
      "additionalProperties": false
    }
  }
}
