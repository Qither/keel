{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.invalid/schemas/proposal.schema.json",
  "title": "keel proposal intake",
  "description": "The .keel/proposals/<P>-<slug>/proposal.yaml, written once by the Steward at keel new on keel/<P>/main from recorded signals, not by a seat. It holds intake signals only: the current track, state and claims are derived from ledger events and never stored here; the base commit is in the proposal.created event.",
  "x-keel-status": "stable",
  "x-keel-milestone": "M1a",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/proposalId" },
    "slug": { "$ref": "common.schema.json#/$defs/slug" },
    "title": { "type": "string", "minLength": 1 },
    "goals": {
      "description": "Active goals the proposal cites (at least one).",
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/goalId" },
      "minItems": 1,
      "uniqueItems": true
    },
    "charter_version": { "$ref": "common.schema.json#/$defs/semver" },
    "created_at": { "$ref": "common.schema.json#/$defs/isoDateTime" },
    "origin": { "$ref": "#/$defs/origin" },
    "request": { "$ref": "#/$defs/request" },
    "requested_track": {
      "description": "Track requested with --track, or null. The classifier may raise it; only keel approve --rule track lowers it.",
      "anyOf": [{ "$ref": "common.schema.json#/$defs/track" }, { "type": "null" }]
    },
    "signals": { "$ref": "#/$defs/signals" }
  },
  "required": [
    "id",
    "slug",
    "title",
    "goals",
    "charter_version",
    "created_at",
    "origin",
    "request",
    "requested_track",
    "signals"
  ],
  "additionalProperties": false,
  "$defs": {
    "origin": {
      "description": "board-signed: started with keel new --policy <id>, the Board signed the verbatim request; contract-approved: the Board signs a contract approval later. Receipts show it.",
      "enum": ["board-signed", "contract-approved"]
    },
    "request": {
      "type": "object",
      "properties": {
        "text": {
          "description": "The verbatim request text as the Board typed it; on the policy path the Board signs exactly these bytes.",
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "description": "Standing policy id for the policy path, or null.",
          "anyOf": [{ "$ref": "common.schema.json#/$defs/slug" }, { "type": "null" }]
        },
        "approval": {
          "description": "The signed request envelope on the policy path, or null.",
          "anyOf": [{ "$ref": "common.schema.json#/$defs/approvalId" }, { "type": "null" }]
        }
      },
      "required": ["text", "policy", "approval"],
      "additionalProperties": false
    },
    "signals": {
      "description": "Recorded signals the track classifier used at intake. The track is recomputed from the actual diff at submit and can only rise.",
      "type": "object",
      "properties": {
        "anchors": { "$ref": "#/$defs/anchors" },
        "predicted_impact": {
          "description": "Predicted impact record computed at intake, or null without an index.",
          "anyOf": [{ "$ref": "common.schema.json#/$defs/impactId" }, { "type": "null" }]
        },
        "elements_reached": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/elementId" },
          "uniqueItems": true
        },
        "boundaries_crossed": {
          "description": "Declared element boundaries the change is predicted to cross.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": { "$ref": "common.schema.json#/$defs/elementId" },
              "to": { "$ref": "common.schema.json#/$defs/elementId" }
            },
            "required": ["from", "to"],
            "additionalProperties": false
          }
        },
        "protected_globs_touched": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/repoGlob" },
          "uniqueItems": true
        },
        "invariants_touched": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/invId" },
          "uniqueItems": true
        },
        "obligations_touched": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/obligationId" },
          "uniqueItems": true
        },
        "public_api_touched": { "type": "boolean" },
        "estimated_files": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        }
      },
      "required": [
        "anchors",
        "predicted_impact",
        "elements_reached",
        "boundaries_crossed",
        "protected_globs_touched",
        "invariants_touched",
        "obligations_touched",
        "public_api_touched"
      ],
      "additionalProperties": false
    },
    "anchors": {
      "description": "What the request cites. A request with no anchor goes to framing.",
      "type": "object",
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "anyOf": [
              { "$ref": "common.schema.json#/$defs/reqId" },
              { "$ref": "common.schema.json#/$defs/scenarioRef" }
            ]
          }
        },
        "elements": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/elementId" }
        },
        "paths": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/repoPath" }
        },
        "symbols": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["requirements", "elements", "paths"],
      "additionalProperties": false
    }
  }
}
