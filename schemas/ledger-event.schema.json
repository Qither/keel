{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.invalid/schemas/ledger-event.schema.json",
  "title": "keel ledger event",
  "description": "One event of the hash-chained ledger, $(git rev-parse --git-common-dir)/keel/ledger/<yyyy-mm>.jsonl: the only truth store for events, with a single writer under an O_EXCL lock. hash is the sha256 of the canonical JSON of the event without hash; prev is the previous event's hash. Board envelopes include the chain head, and state (proposal, task and element status) is computed from events, never stored. Records hold environment variable NAMES, aliases and ${ENV:NAME} placeholders only. The schema is versioned by v; migrations ship as data.",
  "x-keel-status": "stable",
  "x-keel-milestone": "M1a",
  "type": "object",
  "properties": {
    "v": { "const": 1 },
    "id": { "$ref": "common.schema.json#/$defs/eventId" },
    "prev": {
      "description": "hash of the previous event; null only for the first event.",
      "anyOf": [{ "$ref": "common.schema.json#/$defs/sha256" }, { "type": "null" }]
    },
    "ts": { "$ref": "common.schema.json#/$defs/isoDateTime" },
    "type": {
      "description": "Event type; data holds only fields specific to it. The subject, the causing run (actor.run), and the brief and prompt (refs) are never repeated in data.",
      "$ref": "#/$defs/eventType"
    },
    "actor": { "$ref": "#/$defs/actor" },
    "subject": {
      "anyOf": [
        { "$ref": "common.schema.json#/$defs/proposalId" },
        { "$ref": "common.schema.json#/$defs/taskId" },
        { "$ref": "common.schema.json#/$defs/roundId" },
        { "$ref": "common.schema.json#/$defs/runId" },
        { "$ref": "common.schema.json#/$defs/goalId" },
        { "$ref": "common.schema.json#/$defs/contentId" },
        { "type": "null" }
      ]
    },
    "refs": { "$ref": "#/$defs/refs" },
    "data": {
      "type": "object",
      "description": "Type-specific data; $defs/<camelCase type> defines each shape."
    },
    "hash": { "$ref": "common.schema.json#/$defs/sha256" }
  },
  "required": ["v", "id", "prev", "ts", "type", "actor", "subject", "refs", "data", "hash"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "proposal.created" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/proposalCreated" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "track.decided" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/trackDecided" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "hold.changed" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/holdChanged" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "approval.recorded" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/approvalRecorded" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "amendment.recorded" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/amendmentRecorded" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "override.recorded" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/overrideRecorded" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "dispatch.queued" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/dispatchQueued" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "claim.acquired" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/claimAcquired" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "claim.heartbeat" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/claimHeartbeat" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "claim.released" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/claimReleased" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "run.started" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/runStarted" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "run.finished" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/runFinished" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "ack.recorded" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/ackRecorded" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "ruling.made" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/rulingMade" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "question.asked" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/questionAsked" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "result.submitted" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/resultSubmitted" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "round.committed" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/roundCommitted" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "gate.checked" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/gateChecked" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "task.blocked" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/taskBlocked" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "task.unblocked" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/taskUnblocked" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "fix.started" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/fixStarted" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "budget.warned" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/budgetWarned" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "reserved_op.detected" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/reservedOpDetected" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "evidence.recorded" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/evidenceRecorded" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "verdict.recorded" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/verdictRecorded" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "triage.recorded" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/triageRecorded" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "impact.recorded" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/impactRecorded" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "conformance.recorded" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/conformanceRecorded" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "land.completed" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/landCompleted" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "vcs.op" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/vcsOp" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": { "const": "cleanup.completed" }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/$defs/cleanupCompleted" }
        }
      }
    }
  ],
  "$defs": {
    "eventType": {
      "description": "Event types.",
      "enum": [
        "proposal.created",
        "track.decided",
        "hold.changed",
        "approval.recorded",
        "amendment.recorded",
        "override.recorded",
        "dispatch.queued",
        "claim.acquired",
        "claim.heartbeat",
        "claim.released",
        "run.started",
        "run.finished",
        "ack.recorded",
        "ruling.made",
        "question.asked",
        "result.submitted",
        "round.committed",
        "gate.checked",
        "task.blocked",
        "task.unblocked",
        "fix.started",
        "budget.warned",
        "reserved_op.detected",
        "evidence.recorded",
        "verdict.recorded",
        "triage.recorded",
        "impact.recorded",
        "conformance.recorded",
        "land.completed",
        "vcs.op",
        "cleanup.completed"
      ]
    },
    "actor": {
      "description": "Who caused the event. For a drop a seat submits, kind is seat and seat, runtime, declared_family (declared, never verified), alias and run are set; for Steward events, kind is steward and run is set when the event belongs to a run.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["board", "steward", "seat"]
        },
        "seat": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/seat" }, { "type": "null" }]
        },
        "runtime": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/runtimeId" }, { "type": "null" }]
        },
        "declared_family": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/family" }, { "type": "null" }]
        },
        "alias": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/profileAlias" }, { "type": "null" }]
        },
        "run": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/runId" }, { "type": "null" }]
        }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "refs": {
      "description": "Cross references: brief and pg for events tied to a compiled brief and prompt, contract_hash and charter_version in force, commit and tree for events about a commit, and op for the jj operation when the jj backend is enabled.",
      "type": "object",
      "properties": {
        "brief": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/briefId" }, { "type": "null" }]
        },
        "pg": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/promptId" }, { "type": "null" }]
        },
        "contract_hash": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/sha256" }, { "type": "null" }]
        },
        "charter_version": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/semver" }, { "type": "null" }]
        },
        "commit": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/gitOid" }, { "type": "null" }]
        },
        "tree": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/gitOid" }, { "type": "null" }]
        },
        "op": {
          "anyOf": [
            { "description": "jj operation id.", "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "proposalCreated": {
      "description": "Subject: the proposal.",
      "type": "object",
      "properties": {
        "slug": { "$ref": "common.schema.json#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "proposal.schema.json#/$defs/origin" },
        "goals": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/goalId" },
          "minItems": 1
        },
        "policy": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/slug" }, { "type": "null" }]
        },
        "request_approval": {
          "description": "The Board-signed request envelope on the policy path.",
          "anyOf": [{ "$ref": "common.schema.json#/$defs/approvalId" }, { "type": "null" }]
        },
        "base": { "$ref": "common.schema.json#/$defs/gitOid" },
        "branch": { "description": "keel/<P>/main.", "type": "string", "minLength": 1 }
      },
      "required": ["slug", "title", "origin", "goals", "policy", "request_approval", "base", "branch"],
      "additionalProperties": false
    },
    "trackDecided": {
      "description": "Subject: the proposal. The current track is the latest of these events.",
      "type": "object",
      "properties": {
        "track": { "$ref": "common.schema.json#/$defs/track" },
        "previous": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/track" }, { "type": "null" }]
        },
        "cause": {
          "description": "rule: lowered by keel approve --rule track.",
          "enum": ["intake", "ratchet", "rule"]
        },
        "ruling": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/approvalId" }, { "type": "null" }]
        }
      },
      "required": ["track", "previous", "cause", "ruling"],
      "additionalProperties": false
    },
    "holdChanged": {
      "description": "Subject: the proposal (keel run --hold on|off).",
      "type": "object",
      "properties": {
        "on": { "type": "boolean" }
      },
      "required": ["on"],
      "additionalProperties": false
    },
    "approvalRecorded": {
      "description": "Subject: what was approved, or null for a document approval (the envelope names the document).",
      "type": "object",
      "properties": {
        "approval": { "$ref": "common.schema.json#/$defs/approvalId" },
        "kind": { "$ref": "approval.schema.json#/$defs/approvalKind" },
        "stage": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/approvalStage" }, { "type": "null" }]
        },
        "rule": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/ruleKind" }, { "type": "null" }]
        },
        "envelope": {
          "description": "Path under .keel/signatures/.",
          "$ref": "common.schema.json#/$defs/repoPath"
        },
        "fingerprint": { "$ref": "common.schema.json#/$defs/sshFingerprint" }
      },
      "required": ["approval", "kind", "stage", "rule", "envelope", "fingerprint"],
      "additionalProperties": false
    },
    "amendmentRecorded": {
      "description": "Subject: the proposal.",
      "type": "object",
      "properties": {
        "amendment": { "$ref": "common.schema.json#/$defs/amendmentId" }
      },
      "required": ["amendment"],
      "additionalProperties": false
    },
    "overrideRecorded": {
      "type": "object",
      "properties": {
        "override": { "$ref": "common.schema.json#/$defs/overrideId" },
        "check": { "$ref": "common.schema.json#/$defs/checkId" },
        "until": { "$ref": "governance-record.schema.json#/$defs/until" }
      },
      "required": ["override", "check", "until"],
      "additionalProperties": false
    },
    "dispatchQueued": {
      "description": "Subject: the proposal or task.",
      "type": "object",
      "properties": {
        "seat": { "$ref": "common.schema.json#/$defs/seat" },
        "route": { "$ref": "routing.schema.json#/$defs/route" }
      },
      "required": ["seat", "route"],
      "additionalProperties": false
    },
    "claimAcquired": { "description": "Subject: the task.", "$ref": "claim.schema.json" },
    "claimHeartbeat": {
      "description": "Subject: the task; actor.run is the claiming run. Derived from parsed stream events only; there is no separate heartbeat channel.",
      "type": "object",
      "properties": {
        "lease_until": { "$ref": "common.schema.json#/$defs/isoDateTime" }
      },
      "required": ["lease_until"],
      "additionalProperties": false
    },
    "claimReleased": {
      "description": "Subject: the task.",
      "type": "object",
      "properties": {
        "reason": {
          "enum": ["submitted", "cancelled", "expired", "blocked", "failed"]
        }
      },
      "required": ["reason"],
      "additionalProperties": false
    },
    "runStarted": {
      "description": "Subject: the proposal or task. refs.brief and refs.pg carry the brief and the prompt provenance hash.",
      "type": "object",
      "properties": {
        "run": { "$ref": "common.schema.json#/$defs/runId" },
        "seat": { "$ref": "common.schema.json#/$defs/seat" },
        "mode": { "description": "Descriptor mode id.", "$ref": "common.schema.json#/$defs/slug" },
        "route": { "$ref": "routing.schema.json#/$defs/route" },
        "exposure": { "$ref": "run.schema.json#/$defs/exposureProfile" },
        "conformance_status": { "$ref": "common.schema.json#/$defs/conformanceStatus" },
        "submit_channel": { "$ref": "common.schema.json#/$defs/submitChannel" },
        "rung": {
          "description": "null for the direct lane, which sits outside the A-D ladder.",
          "anyOf": [{ "$ref": "common.schema.json#/$defs/rung" }, { "type": "null" }]
        }
      },
      "required": ["run", "seat", "mode", "route", "exposure", "conformance_status", "submit_channel", "rung"],
      "additionalProperties": false
    },
    "runFinished": {
      "type": "object",
      "properties": {
        "run": { "$ref": "common.schema.json#/$defs/runId" },
        "outcome": { "$ref": "run.schema.json#/$defs/outcome" },
        "exit_code": {
          "anyOf": [{ "type": "integer" }, { "type": "null" }]
        }
      },
      "required": ["run", "outcome", "exit_code"],
      "additionalProperties": false
    },
    "ackRecorded": {
      "description": "Subject: the proposal or task; actor is the seat; refs.brief is the compiled brief.",
      "type": "object",
      "properties": {
        "channel": { "$ref": "common.schema.json#/$defs/submitChannel" },
        "attempt": { "type": "integer", "minimum": 1 },
        "matched": { "type": "boolean" },
        "missing": {
          "description": "Ids in the brief's set that the ACK lacks.",
          "type": "array",
          "items": { "$ref": "brief.schema.json#/$defs/ackId" }
        },
        "extra": {
          "description": "Ids in the ACK that the brief's set lacks.",
          "type": "array",
          "items": { "$ref": "brief.schema.json#/$defs/ackId" }
        },
        "write_set_ok": { "type": "boolean" },
        "hash_ok": { "type": "boolean" }
      },
      "required": ["channel", "attempt", "matched", "missing", "extra", "write_set_ok", "hash_ok"],
      "additionalProperties": false
    },
    "rulingMade": {
      "type": "object",
      "properties": {
        "ruling": { "$ref": "common.schema.json#/$defs/rulingId" },
        "clause": { "type": "string", "minLength": 1 },
        "flagged": { "type": "boolean" }
      },
      "required": ["ruling", "clause", "flagged"],
      "additionalProperties": false
    },
    "questionAsked": {
      "type": "object",
      "properties": {
        "question": { "$ref": "common.schema.json#/$defs/questionId" },
        "clause": { "type": "string", "minLength": 1 },
        "routed_to": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/seat" }, { "const": "board" }]
        }
      },
      "required": ["question", "clause", "routed_to"],
      "additionalProperties": false
    },
    "resultSubmitted": {
      "description": "Subject: the proposal or task; actor is the seat; refs.brief is the echoed brief.",
      "type": "object",
      "properties": {
        "status": { "$ref": "common.schema.json#/$defs/resultStatus" },
        "channel": { "$ref": "common.schema.json#/$defs/submitChannel" }
      },
      "required": ["status", "channel"],
      "additionalProperties": false
    },
    "roundCommitted": {
      "description": "Subject: the task; actor.run is the run whose submit produced the round.",
      "type": "object",
      "properties": {
        "round": { "$ref": "common.schema.json#/$defs/roundId" },
        "commit": { "$ref": "common.schema.json#/$defs/gitOid" },
        "tree": { "$ref": "common.schema.json#/$defs/gitOid" },
        "branch": { "description": "keel/<P>/t/<n>.", "type": "string", "minLength": 1 },
        "snapshots": {
          "description": "Seat-made commits preserved under refs/keel/snap/<task>/seat-<n>.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["round", "commit", "tree", "branch", "snapshots"],
      "additionalProperties": false
    },
    "gateChecked": {
      "description": "Subject: the proposal or task. One check result with its denominator; every check fails closed.",
      "type": "object",
      "properties": {
        "check": { "$ref": "common.schema.json#/$defs/checkId" },
        "status": { "$ref": "common.schema.json#/$defs/checkStatus" },
        "passed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "unit": {
          "description": "What the denominator counts, for example 'changed paths in scope'.",
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "reason": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      },
      "required": ["check", "status", "passed", "total", "unit", "reason"],
      "additionalProperties": false
    },
    "taskBlocked": {
      "description": "Subject: the task.",
      "type": "object",
      "properties": {
        "reason": { "$ref": "common.schema.json#/$defs/blockReason" },
        "detail": { "type": "string", "minLength": 1 },
        "unblock_owner": {
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/seat" },
            {
              "enum": ["board", "steward"]
            }
          ]
        }
      },
      "required": ["reason", "detail", "unblock_owner"],
      "additionalProperties": false
    },
    "taskUnblocked": {
      "description": "Subject: the task.",
      "type": "object",
      "properties": {
        "by": {
          "description": "The ruling that unblocked the task, if any.",
          "anyOf": [{ "$ref": "common.schema.json#/$defs/approvalId" }, { "type": "null" }]
        }
      },
      "required": ["by"],
      "additionalProperties": false
    },
    "fixStarted": {
      "description": "Subject: the task.",
      "type": "object",
      "properties": {
        "round": { "description": "Fix round number.", "type": "integer", "minimum": 1 },
        "findings": {
          "description": "Finding ids (VD-<sha12>#<id>).",
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      },
      "required": ["round", "findings"],
      "additionalProperties": false
    },
    "budgetWarned": {
      "description": "Subject: the goal, proposal or task whose budget is at the threshold.",
      "type": "object",
      "properties": {
        "percent": { "type": "integer", "minimum": 0 }
      },
      "required": ["percent"],
      "additionalProperties": false
    },
    "reservedOpDetected": {
      "description": "Leads to blocked(reserved_op) and a Board item.",
      "type": "object",
      "properties": {
        "source": { "$ref": "reserved-actions.schema.json#/$defs/detection" },
        "action": {
          "anyOf": [{ "$ref": "reserved-actions.schema.json#/$defs/actionId" }, { "type": "null" }]
        },
        "ref": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "detail": { "type": "string", "minLength": 1 }
      },
      "required": ["source", "action", "ref", "detail"],
      "additionalProperties": false
    },
    "evidenceRecorded": {
      "type": "object",
      "properties": {
        "evidence": { "$ref": "common.schema.json#/$defs/evidenceId" },
        "commit": { "$ref": "common.schema.json#/$defs/gitOid" },
        "status": { "$ref": "common.schema.json#/$defs/checkStatus" }
      },
      "required": ["evidence", "commit", "status"],
      "additionalProperties": false
    },
    "verdictRecorded": {
      "description": "Subject: the proposal or task; actor is the reviewer seat with its runtime, alias and declared family.",
      "type": "object",
      "properties": {
        "verdict": { "$ref": "common.schema.json#/$defs/verdictId" },
        "lens": { "$ref": "common.schema.json#/$defs/lens" },
        "recommendation": { "$ref": "common.schema.json#/$defs/recommendation" }
      },
      "required": ["verdict", "lens", "recommendation"],
      "additionalProperties": false
    },
    "triageRecorded": {
      "type": "object",
      "properties": {
        "triage": { "$ref": "common.schema.json#/$defs/triageId" },
        "verdict": { "$ref": "common.schema.json#/$defs/verdictId" }
      },
      "required": ["triage", "verdict"],
      "additionalProperties": false
    },
    "impactRecorded": {
      "type": "object",
      "properties": {
        "impact": { "$ref": "common.schema.json#/$defs/impactId" },
        "kind": {
          "enum": ["predicted", "actual"]
        }
      },
      "required": ["impact", "kind"],
      "additionalProperties": false
    },
    "conformanceRecorded": {
      "type": "object",
      "properties": {
        "seat": { "$ref": "common.schema.json#/$defs/seat" },
        "route": { "$ref": "routing.schema.json#/$defs/route" },
        "status": { "$ref": "common.schema.json#/$defs/conformanceStatus" }
      },
      "required": ["seat", "route", "status"],
      "additionalProperties": false
    },
    "landCompleted": {
      "description": "Subject: the proposal.",
      "type": "object",
      "properties": {
        "landed": {
          "description": "The landed commit (the archive commit on trunk).",
          "$ref": "common.schema.json#/$defs/gitOid"
        },
        "trunk": { "type": "string", "minLength": 1 },
        "method": {
          "enum": ["ff-only", "cas-update-ref"]
        },
        "approval": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/approvalId" }, { "type": "null" }]
        },
        "policy": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/slug" }, { "type": "null" }]
        }
      },
      "required": ["landed", "trunk", "method", "approval", "policy"],
      "additionalProperties": false
    },
    "vcsOp": {
      "type": "object",
      "properties": {
        "backend": {
          "enum": ["git", "jj"]
        },
        "op": {
          "description": "Operation, for example worktree-add, update-ref or sparse-checkout.",
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "jj_op": {
          "description": "jj operation id when the jj backend is enabled.",
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      },
      "required": ["backend", "op", "ref", "jj_op"],
      "additionalProperties": false
    },
    "cleanupCompleted": {
      "description": "Subject: the proposal. Only keel-provenance worktrees and refs are removed.",
      "type": "object",
      "properties": {
        "worktrees": { "type": "integer", "minimum": 0 },
        "refs": { "type": "integer", "minimum": 0 }
      },
      "required": ["worktrees", "refs"],
      "additionalProperties": false
    }
  }
}
