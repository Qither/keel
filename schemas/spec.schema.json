{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.invalid/schemas/spec.schema.json",
  "title": "keel living spec",
  "description": "A living requirements file, .keel/specs/<area>/spec.yaml (L2). It is written only by the land archive commit, which applies accepted spec deltas. Requirement text is quoted verbatim into briefs; the RTM check verifies coverage and realization. Verification status is computed from events and never stored here.",
  "x-keel-status": "stable",
  "x-keel-milestone": "M1a",
  "type": "object",
  "properties": {
    "area": {
      "description": "Equals the directory name and the <area> part of every requirement id.",
      "$ref": "common.schema.json#/$defs/areaSlug"
    },
    "charter_version": { "$ref": "common.schema.json#/$defs/semver" },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" },
      "minItems": 1
    }
  },
  "required": ["area", "charter_version", "requirements"],
  "additionalProperties": false,
  "$defs": {
    "requirement": {
      "description": "One living requirement. status and since are set by the archive commit.",
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/reqId" },
        "title": { "description": "Short title.", "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/earsKind" },
        "statement": {
          "description": "One EARS statement, for example 'When <trigger>, the <system> shall <response>.'",
          "type": "string",
          "minLength": 1
        },
        "goals": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/goalId" },
          "minItems": 1,
          "uniqueItems": true
        },
        "realized_in": {
          "description": "Elements that realize the requirement.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/elementId" },
          "uniqueItems": true
        },
        "scenarios": {
          "description": "At least one Given/When/Then scenario.",
          "type": "array",
          "items": { "$ref": "#/$defs/scenario" },
          "minItems": 1
        },
        "status": {
          "enum": ["active", "deprecated"]
        },
        "since": {
          "description": "Proposal whose land added the requirement, or null for one adopted at the trace epoch.",
          "anyOf": [{ "$ref": "common.schema.json#/$defs/proposalId" }, { "type": "null" }]
        }
      },
      "required": ["id", "kind", "statement", "goals", "realized_in", "scenarios", "status", "since"],
      "additionalProperties": false
    },
    "requirementDraft": {
      "description": "A requirement as a spec delta states it; the archive commit adds status (active) and since (the proposal).",
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/reqId" },
        "title": { "description": "Short title.", "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/earsKind" },
        "statement": {
          "description": "One EARS statement, for example 'When <trigger>, the <system> shall <response>.'",
          "type": "string",
          "minLength": 1
        },
        "goals": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/goalId" },
          "minItems": 1,
          "uniqueItems": true
        },
        "realized_in": {
          "description": "Elements that realize the requirement.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/elementId" },
          "uniqueItems": true
        },
        "scenarios": {
          "description": "At least one Given/When/Then scenario.",
          "type": "array",
          "items": { "$ref": "#/$defs/scenario" },
          "minItems": 1
        }
      },
      "required": ["id", "kind", "statement", "goals", "realized_in", "scenarios"],
      "additionalProperties": false
    },
    "earsKind": {
      "description": "EARS pattern of the statement.",
      "enum": ["ubiquitous", "event-driven", "state-driven", "unwanted", "optional", "complex"]
    },
    "scenario": {
      "description": "A Given/When/Then scenario. JUnit rows tagged [R-<area>-<5>#S<n>] map test results to it.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Referenced from outside as R-<area>-<5>#S<n>.",
          "$ref": "common.schema.json#/$defs/scenarioLocalId"
        },
        "title": { "type": "string", "minLength": 1 },
        "given": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 },
        "then": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "given", "when", "then"],
      "additionalProperties": false
    },
    "revHash": {
      "description": "rev_hash: sha256 of the normalized requirement (the canonical JSON of the requirement object, LF, BOM stripped, NFC).",
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}
