{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.invalid/schemas/design-issues.schema.json",
  "title": "keel design-issue register",
  "description": "The canonical register of the design iteration discipline (P5, docs/00-mandate.md section 5), docs/design-issues.yaml. It holds every design issue found in keel's own documents, schemas, templates and tables (class, status, anchors, walk, terms, decision, closure), the standing order map of the design (steps, artifacts, locks) over which the issues check of scripts/validate.mjs runs cycle detection and reachability, the walkthrough matrix (tracks, actors, sequences) and the append-only walkthrough history. Current state only: no narrative, no history of the issue text; git is the history.",
  "$comment": "Not in the strict subset: the fields an issue must carry depend on its status (if/then). An anchor is a file plus a heading (Markdown) or a file plus a JSON pointer (JSON or YAML), never a line number; the issues check resolves each one. Milestone order for the blocks gate: M0 < M1a < M1b < M2 < M3 < M4 < M5 < M6 < M7 < M8. Reachability for the order map: local and supervisor reach every place; clone reaches trunk-commit and archive-commit only; seat reaches working-tree, workspace-root, task-branch and proposal-branch; agent-api (keel's own api, hook and MCP processes in the seat's process tree) reaches those and git-common-dir and refs-keel.",
  "x-keel-status": "stable",
  "x-keel-milestone": "M0",
  "type": "object",
  "properties": {
    "version": { "const": 1 },
    "exit_review": {
      "description": "The milestone whose exit review is in progress, or null between exit reviews. Set only in a milestone-exit commit; while set, the issues check fails on every issue that blocks this or an earlier milestone and is not closed, deferred or dismissed, and on every open issue that has no class yet.",
      "anyOf": [{ "$ref": "#/$defs/milestone" }, { "type": "null" }]
    },
    "matrix": { "$ref": "#/$defs/matrix" },
    "order": { "$ref": "#/$defs/order" },
    "issues": {
      "description": "One entry per finding, ids sequential from DI-01. Closed entries are never deleted: their regression cells are the standing evidence that the chain completes.",
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    },
    "walkthroughs": {
      "description": "Append-only history of walks, oldest first.",
      "type": "array",
      "items": { "$ref": "#/$defs/walkthrough" }
    }
  },
  "required": ["version", "exit_review", "matrix", "order", "issues", "walkthroughs"],
  "additionalProperties": false,
  "$defs": {
    "date": {
      "description": "Calendar date, YYYY-MM-DD.",
      "type": "string",
      "format": "date"
    },
    "milestone": {
      "description": "A milestone of docs/15-roadmap.md.",
      "enum": ["M0", "M1a", "M1b", "M2", "M3", "M4", "M5", "M6", "M7", "M8"]
    },
    "issueId": {
      "description": "keel's own design-issue sequence, separate from the ids keel mints for target projects.",
      "type": "string",
      "pattern": "^DI-[0-9]{2}$"
    },
    "mapId": {
      "description": "Id of a step, artifact, lock, actor or sequence in this register.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "repoPath": {
      "description": "Repository-relative path with forward slashes.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
    },
    "anchor": {
      "description": "Where a statement stands: a file and, for Markdown, the exact text of the heading whose section holds it; for JSON or YAML, a JSON pointer. Never a line number.",
      "type": "object",
      "properties": {
        "file": { "$ref": "#/$defs/repoPath" },
        "heading": { "type": "string", "minLength": 1 },
        "pointer": { "type": "string", "pattern": "^#(/[^/]+)*$" }
      },
      "required": ["file"],
      "additionalProperties": false
    },
    "class": {
      "description": "In precedence order. mandate-conflict: a clause of section 1, a row of section 2 or a KP against a lower level. cycle: a step needs an artifact a later step produces, a wait that only the waited-for step can end, or a place the consumer's machine cannot reach. term-collision: one term with two meanings, or two terms for one thing. gap: an undefined state, a field nothing reads, or a producer too weak for the claim that leans on it. cost: ceremony that asks more than the mandate needs.",
      "enum": ["mandate-conflict", "cycle", "term-collision", "gap", "cost"]
    },
    "status": {
      "description": "open: filed. analysed: classified and walked. proposed: options and a recommendation recorded. decided: the owner or the recommendation decided. closed: corrected, with closure evidence. deferred: by the owner, to a named milestone. dismissed: with a reason.",
      "enum": ["open", "analysed", "proposed", "decided", "closed", "deferred", "dismissed"]
    },
    "foundBy": {
      "enum": ["reader", "external-review", "refresh-review", "walkthrough", "check", "probe", "owner"]
    },
    "rootCause": {
      "description": "rule-tightened: a rule changed and its consumers were not re-walked. term-overloaded: one word, two meanings. no-order-check: a produced-after-required chain nobody walked. silent-reconciliation: a mandate clause reconciled by rewording a lower document. unread-field: a field or measure nothing consumes. cardinality: counts that contradict a stated bound.",
      "enum": ["rule-tightened", "term-overloaded", "no-order-check", "silent-reconciliation", "unread-field", "cardinality", "other"]
    },
    "runsIn": {
      "description": "The machine and process a step runs in. local: a Board or Steward process on the owner's clone with no seat running. supervisor: the keel run process while a seat runs. seat: the seat's own process tree. agent-api: keel's own api, hook and MCP processes started in the seat's process tree. clone: a fresh CI clone with no git common dir state and no refs/keel.",
      "enum": ["local", "supervisor", "seat", "agent-api", "clone"]
    },
    "place": {
      "description": "Where an artifact lives at the moment its consumer reads it. workspace-root: the run directories, outboxes and worktrees under the workspace root outside the repository. task-branch: refs/heads/keel/<P>/t/<n>.",
      "enum": ["working-tree", "workspace-root", "task-branch", "proposal-branch", "git-common-dir", "refs-keel", "trunk-commit", "archive-commit"]
    },
    "cell": {
      "description": "One cell of the walkthrough matrix.",
      "type": "object",
      "properties": {
        "track": { "$ref": "common.schema.json#/$defs/track" },
        "actor": { "$ref": "#/$defs/mapId" },
        "sequence": { "$ref": "#/$defs/mapId" }
      },
      "required": ["track", "actor", "sequence"],
      "additionalProperties": false
    },
    "matrix": {
      "description": "The walkthrough matrix: track x actor x sequence.",
      "type": "object",
      "properties": {
        "tracks": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/track" },
          "minItems": 4,
          "uniqueItems": true
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "$ref": "#/$defs/mapId" },
              "description": { "type": "string", "minLength": 1 }
            },
            "required": ["id", "description"],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "sequences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "$ref": "#/$defs/mapId" },
              "track": {
                "description": "The track this sequence belongs to, or any.",
                "anyOf": [{ "$ref": "common.schema.json#/$defs/track" }, { "const": "any" }]
              },
              "verbs": {
                "description": "The verbs and gates in order, as written in docs/12-cli-api-mcp.md.",
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1
              }
            },
            "required": ["id", "track", "verbs"],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": ["tracks", "actors", "sequences"],
      "additionalProperties": false
    },
    "order": {
      "description": "The standing order map. Every entry is anchored to the heading that states it. An entry tagged with an open issue may sit on a cycle or an unreachable edge; a tag on a closed or dismissed issue is an error.",
      "type": "object",
      "properties": {
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
        "locks": { "type": "array", "items": { "$ref": "#/$defs/lock" } }
      },
      "required": ["steps", "artifacts", "locks"],
      "additionalProperties": false
    },
    "step": {
      "description": "A verb, a gate or a phase step.",
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/mapId" },
        "doc": { "$ref": "#/$defs/anchor" },
        "after": {
          "description": "Steps that must complete before this one.",
          "type": "array",
          "items": { "$ref": "#/$defs/mapId" },
          "uniqueItems": true
        },
        "runs_in": { "$ref": "#/$defs/runsIn" },
        "issue": { "$ref": "#/$defs/issueId" }
      },
      "required": ["id", "doc", "after", "runs_in"],
      "additionalProperties": false
    },
    "artifact": {
      "description": "Something a step produces and other steps require.",
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/mapId" },
        "doc": { "$ref": "#/$defs/anchor" },
        "produced_by": { "$ref": "#/$defs/mapId" },
        "required_by": {
          "type": "array",
          "items": { "$ref": "#/$defs/mapId" },
          "uniqueItems": true
        },
        "where": { "$ref": "#/$defs/place" },
        "issue": { "$ref": "#/$defs/issueId" }
      },
      "required": ["id", "doc", "produced_by", "required_by", "where"],
      "additionalProperties": false
    },
    "lock": {
      "description": "A lock or a wait: who holds it, who waits for it, and which step releases it.",
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/mapId" },
        "doc": { "$ref": "#/$defs/anchor" },
        "held_by": { "$ref": "#/$defs/mapId" },
        "waited_by": {
          "type": "array",
          "items": { "$ref": "#/$defs/mapId" },
          "uniqueItems": true
        },
        "released_by": { "$ref": "#/$defs/mapId" },
        "issue": { "$ref": "#/$defs/issueId" }
      },
      "required": ["id", "doc", "held_by", "waited_by", "released_by"],
      "additionalProperties": false
    },
    "walk": {
      "description": "The four facts of procedure step 3, for every rule the issue names.",
      "type": "object",
      "properties": {
        "producers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "precondition": { "type": "string", "minLength": 1 },
              "producer": { "$ref": "#/$defs/anchor" },
              "position": {
                "description": "Where the producer sits relative to the consumer in the sequence.",
                "enum": ["before", "after", "absent"]
              },
              "sufficient": { "type": "boolean" },
              "reason": { "type": "string", "minLength": 1 }
            },
            "required": ["precondition", "producer", "position", "sufficient", "reason"],
            "additionalProperties": false
          }
        },
        "consumers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "anchor": { "$ref": "#/$defs/anchor" },
              "actor": { "$ref": "#/$defs/mapId" },
              "waits_for": { "type": "string", "minLength": 1 },
              "released_by": { "type": "string", "minLength": 1 },
              "outcome": { "enum": ["pending", "holds", "breaks", "changed", "unchanged"] },
              "reason": { "type": "string", "minLength": 1 }
            },
            "required": ["anchor", "actor", "outcome"],
            "additionalProperties": false
          }
        },
        "places": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifact": { "$ref": "#/$defs/mapId" },
              "where": { "$ref": "#/$defs/place" },
              "reachable_from": {
                "type": "array",
                "items": { "$ref": "#/$defs/runsIn" },
                "uniqueItems": true
              }
            },
            "required": ["artifact", "where", "reachable_from"],
            "additionalProperties": false
          }
        },
        "readers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "readers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            },
            "required": ["field", "readers"],
            "additionalProperties": false
          }
        },
        "tally": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "track": { "$ref": "common.schema.json#/$defs/track" },
              "route": { "enum": ["per-change-contract", "policy-path", "none"] },
              "topology": { "enum": ["shared-trunk", "solo"] },
              "confirmations": { "type": "integer", "minimum": 0 },
              "work_orders": { "type": "integer", "minimum": 0 },
              "bound": { "$ref": "#/$defs/anchor" }
            },
            "required": ["track", "route", "topology", "confirmations", "work_orders", "bound"],
            "additionalProperties": false
          }
        }
      },
      "required": ["producers", "consumers", "places", "readers", "tally"],
      "additionalProperties": false
    },
    "term": {
      "description": "Procedure step 4: one term, the meanings found, the meaning kept and the renamed ones.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "uses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "anchor": { "$ref": "#/$defs/anchor" },
              "meaning": { "type": "string", "minLength": 1 },
              "demands": { "type": "string", "minLength": 1 }
            },
            "required": ["anchor", "meaning"],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "kept": {
          "type": "object",
          "properties": {
            "meaning": { "type": "string", "minLength": 1 },
            "provides": { "type": "string", "minLength": 1 }
          },
          "required": ["meaning", "provides"],
          "additionalProperties": false
        },
        "renamed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "meaning": { "type": "string", "minLength": 1 },
              "new_name": { "type": "string", "minLength": 1 }
            },
            "required": ["meaning", "new_name"],
            "additionalProperties": false
          }
        }
      },
      "required": ["name", "uses"],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "by": { "enum": ["owner", "recommendation"] },
        "date": { "$ref": "#/$defs/date" },
        "option": { "type": "string", "minLength": 1 },
        "recorded_in": {
          "type": "array",
          "items": { "$ref": "#/$defs/repoPath" },
          "minItems": 1
        }
      },
      "required": ["by", "date", "option", "recorded_in"],
      "additionalProperties": false
    },
    "closure": {
      "type": "object",
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "checks": {
          "description": "The validate checks that prove the closure.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "tests": {
          "description": "From M1a, the negative controls in test/ that fail when the defect returns; required for cycle.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "anchors": {
          "description": "The sections rewritten by the closing commit.",
          "type": "array",
          "items": { "$ref": "#/$defs/anchor" },
          "minItems": 1
        }
      },
      "required": ["date", "checks", "tests", "anchors"],
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/issueId" },
        "title": { "type": "string", "minLength": 1 },
        "statement": {
          "description": "One paragraph in keel's own terms: which statements cannot both hold, or what cannot complete.",
          "type": "string",
          "minLength": 1
        },
        "status": { "$ref": "#/$defs/status" },
        "found_by": { "$ref": "#/$defs/foundBy" },
        "found_on": { "$ref": "#/$defs/date" },
        "root_cause": { "$ref": "#/$defs/rootCause" },
        "anchors": {
          "type": "array",
          "items": { "$ref": "#/$defs/anchor" },
          "minItems": 1
        },
        "class": { "$ref": "#/$defs/class" },
        "higher": { "$ref": "#/$defs/anchor" },
        "lower": { "$ref": "#/$defs/anchor" },
        "blocks": {
          "description": "The earliest milestone whose scope builds a producer or consumer of the rule, or at which the owner confirms an adopted-by-recommendation row the fix would change; none when nothing is blocked.",
          "anyOf": [{ "$ref": "#/$defs/milestone" }, { "const": "none" }]
        },
        "walk": { "$ref": "#/$defs/walk" },
        "terms": { "type": "array", "items": { "$ref": "#/$defs/term" } },
        "options": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "recommendation": { "type": "string", "minLength": 1 },
        "decision": { "$ref": "#/$defs/decision" },
        "deferred_until": { "$ref": "#/$defs/milestone" },
        "dismiss_reason": { "type": "string", "minLength": 1 },
        "closure": { "$ref": "#/$defs/closure" },
        "regression": {
          "description": "Cells re-walked at every later iteration and milestone exit; set at close, never removed.",
          "type": "array",
          "items": { "$ref": "#/$defs/cell" }
        }
      },
      "required": ["id", "title", "statement", "status", "found_by", "found_on", "root_cause", "anchors"],
      "additionalProperties": false,
      "allOf": [
        {
          "$comment": "From analysed on, the issue is classified and walked.",
          "if": { "properties": { "status": { "enum": ["analysed", "proposed", "decided", "closed"] } } },
          "then": { "properties": { "class": true, "blocks": true, "walk": true }, "required": ["class", "blocks", "walk"] }
        },
        {
          "$comment": "A mandate conflict names the higher- and lower-ranked anchors.",
          "if": { "properties": { "class": { "const": "mandate-conflict" } }, "required": ["class"] },
          "then": { "properties": { "higher": true, "lower": true }, "required": ["higher", "lower"] }
        },
        {
          "$comment": "From proposed on, at least two options and a recommendation.",
          "if": { "properties": { "status": { "enum": ["proposed", "decided", "closed"] } } },
          "then": { "properties": { "options": { "type": "array", "minItems": 2 }, "recommendation": true }, "required": ["options", "recommendation"] }
        },
        {
          "if": { "properties": { "status": { "enum": ["decided", "closed"] } } },
          "then": { "properties": { "decision": true }, "required": ["decision"] }
        },
        {
          "$comment": "A closed issue carries its closure evidence and at least one regression cell.",
          "if": { "properties": { "status": { "const": "closed" } } },
          "then": { "properties": { "closure": true, "regression": { "type": "array", "minItems": 1 } }, "required": ["closure", "regression"] }
        },
        {
          "$comment": "Only the owner defers, to a named milestone; the issues check verifies decision.by.",
          "if": { "properties": { "status": { "const": "deferred" } } },
          "then": { "properties": { "class": true, "blocks": true, "deferred_until": true, "decision": true }, "required": ["class", "blocks", "deferred_until", "decision"] }
        },
        {
          "if": { "properties": { "status": { "const": "dismissed" } } },
          "then": { "properties": { "dismiss_reason": true }, "required": ["dismiss_reason"] }
        }
      ]
    },
    "walkthrough": {
      "type": "object",
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "trigger": { "enum": ["external-review", "milestone-exit", "rule-change", "refresh-review", "check", "owner", "baseline"] },
        "scope": { "type": "string", "minLength": 1 },
        "cells": { "type": "array", "items": { "$ref": "#/$defs/cell" } },
        "outcome": { "enum": ["clean", "issues"] },
        "issues": {
          "description": "Issues filed or re-walked by this walk.",
          "type": "array",
          "items": { "$ref": "#/$defs/issueId" },
          "uniqueItems": true
        },
        "notes": { "type": "string", "minLength": 1 }
      },
      "required": ["date", "trigger", "scope", "cells", "outcome", "issues"],
      "additionalProperties": false
    }
  }
}
