{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.invalid/schemas/spec-delta.schema.json",
  "title": "keel spec delta",
  "description": "The per-proposal .keel/proposals/<P>-<slug>/spec.delta.yaml, written by the product seat. Operations target requirement ids, never heading text; MODIFIED and REMOVED carry the base rev_hash, and the archive commit refuses on a base mismatch and shows the base, current and proposed texts. The delta blob is part of the contract_hash.",
  "x-keel-status": "stable",
  "x-keel-milestone": "M1a",
  "type": "object",
  "properties": {
    "proposal": { "$ref": "common.schema.json#/$defs/proposalId" },
    "charter_version": { "$ref": "common.schema.json#/$defs/semver" },
    "ops": {
      "type": "array",
      "items": {
        "anyOf": [{ "$ref": "#/$defs/added" }, { "$ref": "#/$defs/modified" }, { "$ref": "#/$defs/removed" }]
      },
      "minItems": 1
    }
  },
  "required": ["proposal", "charter_version", "ops"],
  "additionalProperties": false,
  "$defs": {
    "added": {
      "description": "Adds a requirement; its id is minted without coordination and its area selects the target spec file.",
      "type": "object",
      "properties": {
        "op": { "const": "ADDED" },
        "requirement": { "$ref": "spec.schema.json#/$defs/requirementDraft" }
      },
      "required": ["op", "requirement"],
      "additionalProperties": false
    },
    "modified": {
      "description": "Replaces a requirement.",
      "type": "object",
      "properties": {
        "op": { "const": "MODIFIED" },
        "id": { "$ref": "common.schema.json#/$defs/reqId" },
        "base_rev_hash": { "$ref": "spec.schema.json#/$defs/revHash" },
        "requirement": {
          "description": "The full replacement; its id equals id.",
          "$ref": "spec.schema.json#/$defs/requirementDraft"
        }
      },
      "required": ["op", "id", "base_rev_hash", "requirement"],
      "additionalProperties": false
    },
    "removed": {
      "description": "Removes a requirement.",
      "type": "object",
      "properties": {
        "op": { "const": "REMOVED" },
        "id": { "$ref": "common.schema.json#/$defs/reqId" },
        "base_rev_hash": { "$ref": "spec.schema.json#/$defs/revHash" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "required": ["op", "id", "base_rev_hash", "reason"],
      "additionalProperties": false
    }
  }
}
