{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.invalid/schemas/claim.schema.json",
  "title": "keel claim",
  "description": "A task claim. The lock is refs/keel/claims/<P>.T<n>, created with git update-ref <ref> <blob> <zero-oid> (create-only CAS) and released by a CAS delete; its blob holds the token only. Lease, route and heartbeat state live in ledger events, and claim state is derived from the ledger and cross-checked against the lock. A lost CAS exits 4 and is never retried. This record is the data of the claim.acquired event.",
  "x-keel-status": "stable",
  "x-keel-milestone": "M2",
  "type": "object",
  "properties": {
    "task": { "$ref": "common.schema.json#/$defs/taskId" },
    "ref": { "description": "The lock ref, refs/keel/claims/<P>.T<n>.", "type": "string", "minLength": 1 },
    "token": {
      "description": "Random token; the only content of the lock blob.",
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "run": { "$ref": "common.schema.json#/$defs/runId" },
    "acquired_at": { "$ref": "common.schema.json#/$defs/isoDateTime" },
    "lease_seconds": { "type": "integer", "minimum": 1 },
    "workspace": { "$ref": "#/$defs/workspace" }
  },
  "required": ["task", "ref", "token", "run", "acquired_at", "lease_seconds", "workspace"],
  "additionalProperties": false,
  "$defs": {
    "workspace": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Absolute path of the task worktree under workspace_root; local to this machine.",
          "type": "string",
          "minLength": 1
        },
        "branch": { "description": "Task branch keel/<P>/t/<n>.", "type": "string", "minLength": 1 },
        "base": { "description": "Recorded base commit.", "$ref": "common.schema.json#/$defs/gitOid" },
        "sparse": {
          "description": "Non-cone sparse-checkout patterns; always '/*' and '!/.keel/proposals/'.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "lock_reason": {
          "description": "git worktree lock reason keel:<task>:<run>.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["path", "branch", "base", "sparse"],
      "additionalProperties": false
    }
  }
}
