{{! gemini-policy.toml.tmpl: the per-run Gemini CLI policy file, passed as --policy <run>/gemini-policy.toml.
  keel never writes .gemini/policies (the workspace policy tier is documented as non-functional).
  The --policy flag, its min_version, the rule fields, the tool names and the priority semantics are all
  verification_status unverified until the doctor probe passes; until then Gemini holds only reviewer
  seats that return results through the final message or MCP.
  Rendering: scalar values are escaped for a TOML basic string; regex patterns use TOML literal strings.
  Rules come from the seat contract (allow), org/reserved-actions.yaml and the descriptor's names-only
  provider path set (deny; paths resolved in memory, never opened). }}
# keel per-run policy for {{seat}} on run {{run_id}}. Generated by keel {{keel_version}}; do not edit.
# doctor reports that --policy replaces the user policy directory for this session.

# Provider path set: deny every read, write or listing that touches it.
{{#provider_path_rules}}
[[rule]]
toolName = "{{tool}}"
argsPattern = '{{args_pattern}}'
decision = "deny"
priority = 900

{{/provider_path_rules}}
# Reserved actions (push, ref moves, history rewrites, mutating keel verbs).
{{#reserved_command_prefixes}}
[[rule]]
toolName = "run_shell_command"
commandPrefix = "{{prefix}}"
decision = "deny"
priority = 900

{{/reserved_command_prefixes}}
# Paths this seat may not write (.keel/**, frozen tests, anything outside the write set).
{{#write_deny_rules}}
[[rule]]
toolName = "{{tool}}"
argsPattern = '{{args_pattern}}'
decision = "deny"
priority = 800

{{/write_deny_rules}}
# What the seat contract allows: read-only tools, declared commands and keel api.
{{#allow_rules}}
[[rule]]
toolName = "{{tool}}"
{{#command_prefix}}
commandPrefix = "{{command_prefix}}"
{{/command_prefix}}
decision = "allow"
priority = 500

{{/allow_rules}}
# Everything else is denied.
[[rule]]
toolName = "*"
decision = "deny"
priority = 1
