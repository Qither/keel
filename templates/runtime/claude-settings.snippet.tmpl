{{! claude-settings.snippet.tmpl: printed by keel sync, never written. keel never reads, writes or hashes
  .claude/settings.json; the user pastes this fragment into it for interactive sessions. Headless seats
  use the per-run file from claude-run-settings.json.tmpl instead.
  Rendering: scalar values are escaped for a JSON string; tokens ending in _json are inserted as JSON.
  deny_rules_json denies Read and Edit on the provider path set that runtimes/claude-code.yaml names
  (resolved in memory, never opened) and Bash patterns for the reserved actions.
  keel hook fails open and journals typed outcomes, so these hooks warn; keel's gates decide.
  Hook names and the SessionStart matchers: verification_status documented. }}
{
  "permissions": {
    "deny": {{deny_rules_json}}
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "{{keel_command}} hook session-start --runtime claude-code" }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "{{keel_command}} hook post-compact --runtime claude-code" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "{{keel_command}} hook pre-tool-use --runtime claude-code" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "{{keel_command}} hook user-prompt-submit --runtime claude-code" }
        ]
      }
    ]
  }
}
