{{! opencode.json.tmpl: the per-run opencode config, <run>/opencode.json, selected with
  OPENCODE_CONFIG=<run>/opencode.json. Never merged into a project or user opencode config.
  Rendering: scalar values are escaped for a JSON string; tokens ending in _json are inserted as JSON.
  Provider values appear only as opencode env references to the routed profile's variable NAMES from
  .keel/routing.yaml; opencode resolves them in the child process. keel never writes a value here.
  base_url_env, api_key_env and model_env are those names; alias is the routing alias.
  npm_package and base_url_suffix come from the provider.adapters entry of runtimes/opencode.yaml for the
  profile's protocol (openai-chat, openai-responses or anthropic-messages); the suffix is /v1 for the
  Anthropic adapter and empty otherwise (docs/10-providers.md section 5).
  The permission keys and pattern syntax: verification_status documented; verify by probe per version.
  read_permission_json and edit_permission_json deny the provider path set, .keel and frozen tests;
  bash_permission_json allows declared commands and keel api, and denies reserved actions. }}
{
  "provider": {
    "keel-{{alias}}": {
      "npm": "{{npm_package}}",
      "name": "keel {{alias}}",
      "options": {
        "baseURL": "{env:{{base_url_env}}}{{base_url_suffix}}",
        "apiKey": "{env:{{api_key_env}}}"
      },
      "models": {
        "{{alias}}": {
          "id": "{env:{{model_env}}}"
        }
      }
    }
  },
  "permission": {
    "read": {{read_permission_json}},
    "edit": {{edit_permission_json}},
    "bash": {{bash_permission_json}},
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny",
    "external_directory": "deny"
  },
  "mcp": {
    "keel": {
      "type": "local",
      "command": {{keel_mcp_command_json}},
      "enabled": true
    }
  },
  "share": "disabled",
  "autoupdate": false
}
