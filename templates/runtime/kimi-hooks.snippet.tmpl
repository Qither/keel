{{! kimi-hooks.snippet.tmpl: printed by keel sync, never written. Kimi Code reads hooks only from the
  user-global config.toml in its home directory (KIMI_CODE_HOME), which may also hold provider values,
  so keel never opens, writes or hashes it. The user pastes these tables into it.
  Only PreToolUse, Stop and UserPromptSubmit can block; exit 2 blocks and any other failure allows
  (fail-open). keel hook journals typed outcomes and is never the enforcement boundary: keel's gates
  decide. The same tables serve headless keel runs and interactive sessions in a keel workspace.
  Rendering: scalar values are escaped for a TOML basic string.
  Event names and the four allowed fields (event, matcher, command, timeout): verification_status
  documented for Kimi Code 2.1.0; not installed locally, so verify by probe. }}
# keel hooks for Kimi Code. Paste into the [[hooks]] array of your user-global config.toml.
# Generated by keel {{keel_version}}.

[[hooks]]
event = "SessionStart"
command = "{{keel_command}} hook session-start --runtime kimi-code"
timeout = 10

[[hooks]]
event = "UserPromptSubmit"
command = "{{keel_command}} hook user-prompt-submit --runtime kimi-code"
timeout = 10

[[hooks]]
event = "PreToolUse"
command = "{{keel_command}} hook pre-tool-use --runtime kimi-code"
timeout = 10

[[hooks]]
event = "Stop"
command = "{{keel_command}} hook stop --runtime kimi-code"
timeout = 10
