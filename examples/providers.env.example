# examples/providers.env.example: the environment variable NAMES that the acme-notes routing
# (examples/acme-notes/.keel/routing.yaml) refers to. NAMES ONLY: every value here is the placeholder
# <set-in-your-own-environment>, and keel never reads this file or any file you fill in.
#
# Set each value yourself, outside keel and outside any repository, for example:
#   - as Windows user environment variables (System Properties > Environment Variables);
#   - in your shell profile;
#   - in a secret manager that injects variables into one process, for example `op run -- keel run P-7F3K9Q`.
# Do not commit a filled copy anywhere; keel's validate refuses repository files named .env or .env.*.
#
# keel dereferences these values only in process memory, at spawn and at direct-lane call time, passes
# only the routed profile's variables to a child under the runtime's native names, and never prints, logs,
# hashes or persists them. Check which names are set with `keel doctor --section providers` (it prints SET
# or UNSET, never a value).
#
# Endpoint values are placeholders here, never real hosts. Their shape depends on the protocol
# (docs/10-providers.md section 5): for anthropic-messages the host root without a version segment, like
# https://provider.example.invalid; for openai-chat and openai-responses the value with the version
# segment, like https://provider.example.invalid/v1.
# A model variable may stay unset when no seat uses that tier on the alias.

# anthropic-main: protocol anthropic-messages, declared family anthropic (claude-code seats).
KEEL_PROFILE_ANTHROPIC_MAIN_BASE_URL=<set-in-your-own-environment>
KEEL_PROFILE_ANTHROPIC_MAIN_API_KEY=<set-in-your-own-environment>
KEEL_PROFILE_ANTHROPIC_MAIN_MODEL_FRONTIER=<set-in-your-own-environment>
KEEL_PROFILE_ANTHROPIC_MAIN_MODEL_STANDARD=<set-in-your-own-environment>
KEEL_PROFILE_ANTHROPIC_MAIN_MODEL_FAST=<set-in-your-own-environment>

# gemini-compat: protocol openai-chat, declared family google (the reviewer on opencode).
KEEL_PROFILE_GEMINI_COMPAT_BASE_URL=<set-in-your-own-environment>
KEEL_PROFILE_GEMINI_COMPAT_API_KEY=<set-in-your-own-environment>
KEEL_PROFILE_GEMINI_COMPAT_MODEL_FRONTIER=<set-in-your-own-environment>
KEEL_PROFILE_GEMINI_COMPAT_MODEL_STANDARD=<set-in-your-own-environment>
KEEL_PROFILE_GEMINI_COMPAT_MODEL_FAST=<set-in-your-own-environment>

# glm-main: protocol openai-chat, declared family zhipu (the test-first task on opencode).
KEEL_PROFILE_GLM_MAIN_BASE_URL=<set-in-your-own-environment>
KEEL_PROFILE_GLM_MAIN_API_KEY=<set-in-your-own-environment>
KEEL_PROFILE_GLM_MAIN_MODEL_FRONTIER=<set-in-your-own-environment>
KEEL_PROFILE_GLM_MAIN_MODEL_STANDARD=<set-in-your-own-environment>
KEEL_PROFILE_GLM_MAIN_MODEL_FAST=<set-in-your-own-environment>
